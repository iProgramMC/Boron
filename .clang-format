#
# Clang-format formatting description file for Boron.

UseTab: AlignWithSpaces
IndentWidth: 4
TabWidth: 4

ColumnLimit: 100

AttributeMacros: ['UNUSED', 'FORCE_INLINE', 'ALWAYS_INLINE', 'INIT', 'NO_RETURN']
BreakAfterAttributes: Always
BreakBeforeReturnType: All

# example:
# Status = MmAllocatePool(
#     POOL_NONPAGED,
#     SizeOfAllocatedPayload
# );
AlignAfterOpenBracket: false
BreakAfterOpenBracketFunction: true
BreakBeforeCloseBracketFunction: true
PackArguments:
  BinPack: OnePerLine
PackParameters:
  BinPack: OnePerLine

AlignConsecutiveBitFields:
  Enabled: true

AlignConsecutiveMacros:
  Enabled: true

AlignConsecutiveShortCaseStatements:
  Enabled: true

AlignEscapedNewlines: LeftWithLastLine

AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0

BreakBeforeBraces: Custom
BraceWrapping:
  AfterEnum: true
  AfterStruct: true
  AfterClass: true
  AfterCaseLabel: true
  AfterFunction: true
  AfterNamespace: true
  AfterUnion: true
  AfterExternBlock: true
  AfterControlStatement: Always
  BeforeCatch: true
  BeforeElse: true
  BeforeWhile: true
  BeforeLambdaBody: true

IndentCaseLabels: true

AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false

ReflowComments: Never

# There is a reason I put includes in a certain order.
SortIncludes:
  Enabled: false

# Used for plain-old-data types.  Always on left.
# Supposed to be "move to right if there are multiple",
# but clang-format doesn't seem to support that.
PointerAlignment: Left

SpaceAfterCStyleCast: true

BreakStringLiterals: false

AllowShortFunctionsOnASingleLine: false

BreakBinaryOperations:
  Default: OnePerLine
  PerOperator:
  - Operators: ['==', '<', '>', '<=', '>=', '!=']
    Style: Never

BreakBeforeBinaryOperators: false

PenaltyBreakAssignment: 1000
